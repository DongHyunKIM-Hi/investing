# 로컬 DB (docker compose up -d). 앱 컨테이너는 compose가 db 호스트로 덮어씀
DATABASE_URL=postgresql+psycopg://ggeol:ggeol@localhost:5432/ggeol
# 로그인 비밀번호와 세션 서명 키. 둘 다 반드시 바꿀 것 (python -c "import secrets;print(secrets.token_urlsafe(32))")
APP_PASSWORD=
SESSION_SECRET=
# 있으면 Claude와 대화로 상담, 없으면 폼 + 키워드 태그 추천
ANTHROPIC_API_KEY=
